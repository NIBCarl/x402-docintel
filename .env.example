# x402 mode: testnet (Base Sepolia, free test USDC) or mainnet (real USDC)
# Testnet is for plumbing checks only: settlement there is invisible to the x402
# Bazaar and to on-chain census data, so it can never produce real revenue.
X402_MODE=testnet

# REQUIRED. Wallet that receives every payment. Must be one you control.
# Generate one with: npm run genwallet            (testnet)
#                    node src/gen-wallet.mjs --mainnet   (real revenue)
# The server only needs the address; it never loads a private key at runtime.
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Optional overrides
# PORT=4021
# FACILITATOR_URL=https://facilitator.payai.network
# SERVICE_NAME=DocIntel
# PUBLIC_URL=https://your-service.example.com
# PRICE_PDF_TEXT=$0.02
# PRICE_DOC_KEYDATA=$0.15
# PRICE_PDF_INVOICE=$0.25
# PRICE_INVOICE_VALIDATE=$0.50
# MAX_PDF_PAGES=200
# MAX_PDF_BYTES=6291456
# MAX_BODY_BYTES=8388608

# No CDP credentials are required to SETTLE: facilitator.payai.network serves scheme=exact
# on eip155:8453. Only set these if you deliberately switch FACILITATOR_URL to
# https://api.cdp.coinbase.com/platform/v2/x402
# Caveat: settling without CDP is not the same as being listed in the CDP Bazaar.
# Listing is earned by settlement, and payai-settled resources were not found in
# either catalog on 2026-11-03 (see DEPLOY.md -> Discovery).
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

