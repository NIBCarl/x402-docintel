# x402 mode: testnet (Base Sepolia, free test USDC) or mainnet (real USDC)
X402_MODE=testnet

# REQUIRED. Wallet that receives every payment. Must be one you control.
# Generate a testnet one with: npm run genwallet
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Optional overrides
# PORT=4021
# FACILITATOR_URL=https://x402.org/facilitator
# PRICE_PDF_TEXT=$0.01
# PRICE_PDF_INVOICE=$0.05
# PRICE_DOC_KEYDATA=$0.03
# MAX_PDF_PAGES=200
# MAX_PDF_BYTES=6291456
# MAX_BODY_BYTES=8388608

# Required only for mainnet: Coinbase CDP facilitator credentials
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
